# Copy to .env (gitignored). Win/Linux: keep COMPOSE_PATH_SEPARATOR as "|".
# Quote values that contain | so bash `source .env` does not treat them as pipes.
COMPOSE_PATH_SEPARATOR="|"
COMPOSE_FILE="docker-compose.yml|compose.neo4j.yml|compose.tls.yml"
COMPOSE_PROJECT_NAME=sixath

WEB_HOST_PORT=18080
GATEWAY_HOST_PORT=18088
PORTAL_HTTP_HOST_PORT=18000
PORTAL_GRPC_HOST_PORT=19000
MYSQL_HOST_PORT=13306
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687

# Portal data_root host path (skills / agent workspaces / vectors). Survives container recreate.
PORTAL_DATA_DIR=./data/portal

# Host dir → portal /mnt/codes (read-only). Default ./codes
HOST_CODE_ROOT=./codes

BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# TLS profile (deploy --with-tls requires a real DOMAIN, not localhost)
DOMAIN=
ACME_EMAIL=admin@example.com
