# Copy to .env (gitignored). Win/Linux: keep COMPOSE_PATH_SEPARATOR=|.
COMPOSE_PATH_SEPARATOR=|
COMPOSE_FILE=docker-compose.yml|compose.neo4j.yml|compose.tls.yml
COMPOSE_PROJECT_NAME=sixath

WEB_HOST_PORT=18080
GATEWAY_HOST_PORT=18088
PORTAL_HTTP_HOST_PORT=18000
PORTAL_GRPC_HOST_PORT=19000
MYSQL_HOST_PORT=13306
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687

BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# TLS profile (deploy --with-tls requires a real DOMAIN, not localhost)
DOMAIN=
ACME_EMAIL=admin@example.com
