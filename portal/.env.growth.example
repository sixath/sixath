# 复制为 portal/.env.growth 后执行: . .\scripts\setup_growth_env.ps1
# 配置后 Growth 优先走真 LLM；未配置时回退 config.yaml 中的 review_patch_file

SATH_GROWTH_LLM_PROVIDER=openai
SATH_GROWTH_LLM_MODEL=gpt-4o-mini
SATH_GROWTH_LLM_API_KEY=sk-your-key-here
SATH_GROWTH_LLM_BASE_URL=https://api.openai.com/v1
SATH_GROWTH_LLM_MAX_TRANSCRIPT_RUNES=24000
