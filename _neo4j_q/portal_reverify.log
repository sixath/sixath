 err := b.repo.GetReleaseQueueSize(ctx); err != nil {\n126|\t\treturn nil, err\n127|\t} else {\n128|\t\tb.releaseQueueMetric.Length.Record(ctx, size) // 监控采集释放队列的大小\n129|\t}\n130|\n131|\ttimeout := time.Now().Unix() - conf.GetApplicationConfig(\"cg_session_release_queue_timeout\").MustInt64(60)\n132|\tif timeoutSize, err := b.repo.GetTimeoutReleaseQueueSize(ctx, timeout); err != nil {\n133|\t\treturn nil, err\n134|\t} else {\n135|\t\tb.releaseQueueMetric.TimeoutLength.Record(ctx, timeoutSize) // 监控超时的释放队列大小\n136|\t}\n137|\n138|\tcount := conf.GetApplicationConfig(\"cg_session_release_queue_timeout_max_count\").MustInt64(100)\n139|\treturn b.repo.RangeTimeoutReleaseQueue(ctx, timeout, 0, count)\n140|}\n141|\n142|func (b *ScheduleBiz) RangeReleaseQueue(ctx context.Context, offset, count int64) ([]*ReleaseTask, error) {\n143|\ttimeout := time.Now().Unix()\n144|\treturn b.repo.RangeTimeoutReleaseQueue(ctx, timeout, offset, count)\n145|}\n146|\n147|func (b *ScheduleBiz) ReleaseFromQueue(ctx context.Context, uid, gid uint64, scheduleId, flowId string, bizType int32) error {\n148|\ttask := \u0026ReleaseTask{\n149|\t\tUuid:       uid,\n150|\t\tScheduleId: scheduleId,\n151|\t\tFlowId:     flowId,\n152|\t}\n153|\t// 先确认释放队列中是否有任务\n154|\tif _, err := b.repo.GetReleaseTaskEnqueueTime(ctx, task); err != nil {\n155|\t\treturn err\n156|\t}\n157|\t// 调用调度释放VM\n158|\tif err := b.Release(ctx, uid, gid, scheduleId, bizType); err != nil {\n159|\t\treturn err\n160|\t}\n161|\t// 释放成功后，删除释放队列中的任务\n162|\tif _, err := b.repo.RemFromReleaseQueue(ctx, task); err != nil {\n163|\t\treturn err\n164|\t}\n165|\treturn nil\n166|}\n167|\n168|func (b *ScheduleBiz) Release(ctx context.Context, uid, gid uint64, scheduleId string, bizType int32) error {\n169|\treq := \u0026cgschedule.ReleaseRequest{\n170|\t\tUuid:        int64(uid),\n171|\t\tScheduleId:  scheduleId,\n172|\t\tReleaseType: cgschedule.ReleaseType_Normal,\n173|\t\tBizType:     int64(bizType),\n174|\t\tGid:         int64(gid),\n175|\t}\n176|