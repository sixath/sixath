o.RemFromReleaseQueue(ctx, task); err != nil {\n163|\t\treturn err\n164|\t}\n165|\treturn nil\n166|}\n167|\n168|func (b *ScheduleBiz) Release(ctx context.Context, uid, gid uint64, scheduleId string, bizType int32) error {\n169|\treq := \u0026cgschedule.ReleaseRequest{\n170|\t\tUuid:        int64(uid),\n171|\t\tScheduleId:  scheduleId,\n172|\t\tReleaseType: cgschedule.ReleaseType_Normal,\n173|\t\tBizType:     int64(bizType),\n174|\t\tGid:         int64(gid),\n175|\t}\n176|\tctx = mwkits.AppendMetaDataBizType(ctx, int64(bizType))\n177|\treturn b.repo.Release(ctx, req)\n178|}\n179|\n180|func (b *ScheduleBiz) QueryQueueStatus(ctx context.Context, req *cgschedule.QueryQueueStatusRequest) (*cgschedule.QueueStatusInfo, error) {\n181|\treturn b.repo.QueryQueueStatus(ctx, req)\n182|}\n183|\n184|func (b *ScheduleBiz) newScheduleRequest(\n185|\tctx context.Context,\n186|\tsession SessionInfo,\n187|\tflowCache *FlowCache,\n188|\tapplyOption *pb.SessionApplyOption,\n189|) (*cgschedule.ScheduleRequest, error) {\n190|\tdeviceCache, ok := session.GetCurrentDevice()\n191|\tif !ok {\n192|\t\treturn nil, fmt.Errorf(\"session device cache not found\")\n193|\t}\n194|\n195|\tnetAddr := deviceCache.NetAddrProperty\n196|\tscheduleId := flowCache.ScheduleId\n197|\tif scheduleId == \"\" {\n198|\t\tscheduleId = appkits.GenerateRandomString(16)\n199|\t\tflowCache.ScheduleId = scheduleId\n200|\t}","evidence_refs":[{"kind":"rca_read","repo":"cloudgame","path":"rock-stack-session/apps/cgsession/internal/biz/schedule.go"}],"file":"rock-stack-session/apps/cgsession/internal/biz/schedule.go","ok":true,"repo":"cloudgame","total_lines":302},"seq":24,"step":8,"toolName":"rca_read"},{"kind":"model","messageCount":27,"mode":"tools_stream","model":"deepseek-v4-pro","phase":"responded","seq":25,"step":9},{"allowed":true,"arguments":{"glob":"*.go","pattern":"RetryRelease"},"decision":"allowed","durationMs":107,"id":"call_d1291c41500b48bc91afa0a6","kind":"tool","phase":"completed","result":{"evidence_refs":[