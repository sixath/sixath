679|\r\n680|\texpiredTime := time.Unix(user.HostingStartTime, 0).Add(time.Duration(user.HostingDuration) * time.Second)\r\n681|\tnow := time.Now()\r\n682|\tif now.Before(expiredTime) {\r\n683|\t\terr = b.UpdateFlowCache(ctx, user.BizType, user.FlowID, map[string]any{\r\n684|\t\t\t\"active_ts\": now.Unix(),\r\n685|\t\t})\r\n686|\t\tif err != nil {\r\n687|\t\t\tlog.Errorf(ctx, \"UpdateFlowCache error: %v,flowId: %s\", err, user.FlowID)\r\n688|\t\t}\r\n689|\r\n690|\t\terr = b.deviceBiz.UpdateDeviceCache(\u0026UserDeviceCtx{\r\n691|\t\t\tContext: ctx,\r\n692|\t\t\tUUID:    uid,\r\n693|\t\t\tDevID:   devId,\r\n694|\t\t}, user.BizType, map[string]any{\r\n695|\t\t\t\"heartbeat_ts\": now.Unix(),\r\n696|\t\t})\r\n697|\t\tif err != nil {\r\n698|\t\t\tlog.Errorf(ctx, \"UpdateDeviceCache error: %v,uid: %d,devId: %s\", err, uid, device.DevID)\r\n699|\t\t}\r\n700|\r","evidence_refs":[{"kind":"rca_read","repo":"cloudgame","path":"rock-stack-session/apps/cgsession/internal/biz/flow.go"}],"file":"rock-stack-session/apps/cgsession/internal/biz/flow.go","ok":true,"repo":"cloudgame","total_lines":715},"seq":89,"step":30,"toolName":"rca_read"},{"allowed":true,"arguments":{"end_line":180,"file":"rock-stack-session/apps/cgsession/internal/biz/schedule.go","repo":"cloudgame","start_line":120},"decision":"allowed","id":"call_01_B4Ife0l8IGGxRMh0nBp76497","kind":"tool","phase":"completed","result":{"content":"120|\t})\n121|}\n122|\n123|// CheckReleaseQueue 定时任务调用这里监控释放队列，进行监控和兜底处理，防止异常导致资源无法释放\n124|func (b *ScheduleBiz) CheckReleaseQueue(ctx context.Context) ([]*ReleaseTask, error) {\n125|\tif size, err := b.repo.GetReleaseQueueSize(ctx); err != nil {\n126|\t\treturn nil, err\n127|\t} else {\n128|\t\tb.releaseQueueMetric.Length.Record(ctx, size) // 监控采集释放队列的大小\n129|\t}\n130|\n131|\ttimeout := time.Now().Unix() - conf.GetApplicationConfig(\"cg_session_release_queue_timeout\").MustInt64(60)\n132|\tif timeoutSize, err := b.repo.GetTimeoutReleaseQueueSize(ctx, timeout); err != nil {\n133|\t\treturn nil, err\n134|\t} else {\n135|\t\tb.releaseQueueMetric.TimeoutLength.Record(ctx, timeoutSize) // 监控超时的释放队列大小\n136|\t}\n137|\n138|\tcount := conf.GetApplicationConfig(\"cg_session_release_queue_timeout_max_count\").MustInt64(100)\n139|\treturn b.repo.RangeTimeoutReleaseQueue(ctx, timeout, 0, count)\n140|}\n141|\n142|func (b *ScheduleBiz) RangeReleaseQueue(ctx context.Context, offset, count int64) ([]*ReleaseTask, error) {\n143|\ttimeout := time.Now().Unix()\n144|\treturn b.repo.RangeTimeoutReleaseQueue(ctx, timeout, offset, count)\n145|}\n146|\n147|func (b *ScheduleBiz) ReleaseFromQueue(ctx context.Context, uid, gid uint64, scheduleId, flowId string, bizType int32) error {\n148|\ttask := \u0026ReleaseTask{\n149|\t\tUuid:       uid,\n150|\t\tScheduleId: scheduleId,\n151|\t\tFlowId:     flowId,\n152|\t}\n153|\t// 先确认释放队列中是否有任务\n154|\tif _, err := b.repo.GetReleaseTaskEnqueueTime(ctx, task); err != nil {\n155|\t\treturn err\n156|\t}\n157|\t// 调用调度释放VM\n158|\tif err := b.Release(ctx, uid, gid, scheduleId, bizType); err != nil {\n159|\t\treturn err\n160|\t}\n161|\t// 释放成功后，删除释放队列中的任务\n162|\tif _, err := b.repo.RemFromReleaseQueue(ctx, task); err != nil {\n163|\t\treturn err\n164|\t}\n165|\treturn nil\n166|}\n167|\n168|func (b *ScheduleBiz) Release(ctx context.Context, uid, gid uint64, scheduleId string, bizType int32) error {\n169|\treq := \u0026cgschedule.ReleaseRequest{\n170|\t\tUuid:        int64(uid),\n171|\t\tScheduleId:  scheduleId,\n172|\t\tReleaseType: cgschedule.ReleaseType_Normal,\n173|\t\tBizType:     int64(bizType),\n174|\t\tGid:         int64(gid),\n175|\t}\n176|\tctx = mwkits.AppendMetaDataBizType(ctx, int64(bizType))\n177|\treturn b.repo.Release(ctx, req)\n178|}\n179|\n180|func (b *ScheduleBiz) QueryQueueStatus(ctx context.Context, req *cgschedule.QueryQueueStatusRequest) (*cgschedule.QueueStatusInfo, error) {","evidence_refs":[{"kind":"rca_read","repo":"cloudgame","path":"rock-stack-session/apps/cgsession/internal/biz/schedule.go"}],"file":"rock-stack-s