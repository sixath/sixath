, devId)\r\n673|\t\treturn false\r\n674|\t}\r\n675|\r\n676|\tif user.HostingStatus != 1 {\r\n677|\t\treturn false\r\n678|\t}\r\n679|\r\n680|\texpiredTime := time.Unix(user.HostingStartTime, 0).Add(time.Duration(user.HostingDuration) * time.Second)\r\n681|\tnow := time.Now()\r\n682|\tif now.Before(expiredTime) {\r\n683|\t\terr = b.UpdateFlowCache(ctx, user.BizType, user.FlowID, map[string]any{\r\n684|\t\t\t\"active_ts\": now.Unix(),\r\n685|\t\t})\r\n686|\t\tif err != nil {\r\n687|\t\t\tlog.Errorf(ctx, \"UpdateFlowCache error: %v,flowId: %s\", err, user.FlowID)\r\n688|\t\t}\r\n689|\r\n690|\t\terr = b.deviceBiz.UpdateDeviceCache(\u0026UserDeviceCtx{\r\n691|\t\t\tContext: ctx,\r\n692|\t\t\tUUID:    uid,\r\n693|\t\t\tDevID:   devId,\r\n694|\t\t}, user.BizType, map[string]any{\r\n695|\t\t\t\"heartbeat_ts\": now.Unix(),\r\n696|\t\t})\r\n697|\t\tif err != nil {\r\n698|\t\t\tlog.Errorf(ctx, \"UpdateDeviceCache error: %v,uid: %d,devId: %s\", err, uid, device.DevID)\r\n699|\t\t}\r\n700|\r","evidence_refs":[{"kind":"rca_read","repo":"cloudgame","path":"rock-stack-session/apps/cgsession/internal/biz/flow.go"}],"file":"rock-stack-session/apps/cgsession/internal/biz/flow.go","ok":true,"repo":"cloudgame","total_lines":715},"seq":30,"step":9,"toolName":"rca_read"},{"kind":"model","messageCount":35,"mode":"tools_stream","model":"deepseek-v4-pro","phase":"responded","seq":31,"step":10},{"allowed":true,"arguments":{"body":"{\"query\":{\"query_string\":{\"query\":\"\\\"TMuvu0uu5v2E\\\" AND \\\"retryReleaseTask\\\"\",\"default_field\":\"M\"}},\"size\":50,\"sort\":[{\"@timestamp\":\"asc\"}]}","headers":{"Content-Type":"application/json"},"method":"POST","url":"http://10.137.211.84:29200/backend-cgsession-*/_search"},"decision":"allowed","durationMs":136,"id":"call_00_1pglV369dmtf0fCp0wcq5299","kind":"tool","phase":"completed","result":{"body":"{\"took\":126,\"timed_out\":false,\"_shards\":{\"total\":80,\"successful\":80,\"skipped\":0,\"failed\":0},\"hits\":{\"total\":{\"value\":0,\"relati